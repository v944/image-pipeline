{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.imagepipeline.art" }],
      "destination": "https://imagepipeline.art",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "ref" }],
      "destination": "/:path?ref=",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "source" }],
      "destination": "/:path?source=",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "utm_source" }],
      "destination": "/:path?utm_source=",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "utm_medium" }],
      "destination": "/:path?utm_medium=",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "utm_campaign" }],
      "destination": "/:path?utm_campaign=",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "utm_term" }],
      "destination": "/:path?utm_term=",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "utm_content" }],
      "destination": "/:path?utm_content=",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "fbclid" }],
      "destination": "/:path?fbclid=",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "query", "key": "gclid" }],
      "destination": "/:path?gclid=",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.ts" },
    { "source": "/api/event", "destination": "/api/event.ts" },
    { "source": "/api/check-limit", "destination": "/api/check-limit.ts" },
    { "source": "/api/crypto/config", "destination": "/api/crypto/config.ts" },
    { "source": "/api/crypto/recover", "destination": "/api/crypto/recover.ts" },
    { "source": "/api/crypto/telegram-pay", "destination": "/api/crypto/telegram-pay.ts" },
    { "source": "/api/crypto/verify", "destination": "/api/crypto/verify.ts" },
    { "source": "/api/pipeline/share", "destination": "/api/pipeline/share.ts" },
    { "source": "/api/pipeline/([^/]+)", "destination": "/api/pipeline/[shareId].ts" },
    { "source": "/api/subscribe", "destination": "/api/subscribe.ts" },
    { "source": "/api/unsubscribe", "destination": "/api/unsubscribe.ts" },
    { "source": "/api/subscribers", "destination": "/api/subscribers.ts" },
    { "source": "/api/stats", "destination": "/api/stats.ts" },
    { "source": "/api/newsletter", "destination": "/api/newsletter.ts" },
    { "source": "/api/error", "destination": "/api/error.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://www.google-analytics.com https://api.producthunt.com https://speaktechenglish.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://analytics.google.com; worker-src 'self' blob:; frame-src 'none'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
